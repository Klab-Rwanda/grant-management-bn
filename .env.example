# Application
NODE_ENV=development
API_PORT=3001
WEB_PORT=3000
LOG_LEVEL=info

# PostgreSQL (local Docker Compose defaults — replace in non-local environments)
DATABASE_URL=postgresql://grant_ledger:grant_ledger_dev@localhost:5432/grant_ledger

# Redis
REDIS_URL=redis://localhost:6379

# Object Storage (MinIO locally / S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=grant-ledger-vault
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=20000

# Outbound Email (Mailpit locally)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=noreply@grantledger.local

# Web Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
WEB_BASE_URL=http://localhost:3000

# Authentication (use a unique random value of at least 32 characters outside local development)
AUTH_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
