{
  "name": "@grant-ledger/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @grant-ledger/shared build && nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:migrate": "node-pg-migrate up -m migrations --migration-file-language sql",
    "db:migrate:down": "node-pg-migrate down -m migrations --migration-file-language sql",
    "openapi:generate": "tsx src/openapi.ts"
  },
  "dependencies": {
    "@grant-ledger/shared": "workspace:*",
    "@nestjs/common": "^11.0.11",
    "@nestjs/core": "^11.0.11",
    "@nestjs/platform-express": "^11.0.11",
    "@nestjs/swagger": "^11.0.6",
    "class-validator": "^0.14.2",
    "dotenv": "^16.4.7",
    "fast-xml-parser": "^5.12.1",
    "kysely": "^0.27.6",
    "node-pg-migrate": "^8.0.0",
    "nodemailer": "^10.6.1",
    "pg": "^8.14.1",
    "pino": "^9.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.5",
    "@nestjs/testing": "^11.0.11",
    "@testcontainers/postgresql": "^10.22.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.10",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
